{
  "meta": {
    "lastTouchedVersion": "2026.1.27-beta.1"
  },
  "browser": {
    "enabled": false
  },
  "auth": {
    "profiles": {
      "zai:default": {
        "provider": "zai",
        "mode": "api_key"
      },
      "moonshot:default": {
        "provider": "moonshot",
        "mode": "api_key"
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "zai/glm-5",
        "fallbacks": [
          "zai/glm-4.7"
        ]
      },
      "workspace": "__OPENSWARM_ROOT__/hexes/__HEX_NAME__/workspace",
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      }
    }
  },
  "tools": {
    "web": {
      "search": {
        "enabled": true
      },
      "fetch": {
        "enabled": true
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": false
    }
  },
  "gateway": {
    "port": 99999,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "openswarm_local_replace_me"
    },
    "tailscale": {
      "mode": "off"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "skills": {
    "install": {
      "nodeManager": "npm"
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": false
      }
    }
  }
}
