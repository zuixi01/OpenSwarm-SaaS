# OpenSwarm Alibaba Cloud ECS beta template
# Target host: Alibaba Cloud Linux 3 / 8 vCPU / 16 GiB / local runtime

NODE_ENV=production
PANEL_WEB_PORT=3999

# Public site
OPENSWARM_PUBLIC_BASE_URL=https://app.example.com

# Database
DATABASE_URL=postgres://openswarm:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/openswarm
DATABASE_SSLMODE=disable
DATABASE_POOL_MAX=20
DATABASE_IDLE_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=3000

# SaaS auth
OPENSWARM_REQUIRE_USER_AUTH=1
OPENSWARM_AUTH_JWT_SECRET=CHANGE_ME_PHASE1_JWT_SECRET
OPENSWARM_AUTH_REFRESH_SECRET=CHANGE_ME_PHASE1_REFRESH_SECRET
OPENSWARM_AUTH_COOKIE_SECURE=0

# Legacy/OpenAPI compatibility
OPENSWARM_V1_JWT_SECRET=CHANGE_ME_V1_JWT_SECRET
OPENSWARM_V1_BOOTSTRAP_EMAIL=admin@example.com
OPENSWARM_V1_BOOTSTRAP_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD

# Google login
# 建议等域名 + HTTPS 准备好后再启用
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Runtime
OPENSWARM_RUNTIME_MODE=local
OPENSWARM_RUNTIME_TOKEN_SECRET=CHANGE_ME_RUNTIME_SECRET
OPENSWARM_TENANT_RUNTIME_BASE_DIR=/data/openswarm/runtime/tenants
OPENSWARM_TENANT_RUNTIME_LOG_DIR=/data/openswarm/runtime/logs
OPENSWARM_TENANT_RUNTIME_PORT_START=19001
OPENSWARM_TENANT_RUNTIME_PORT_END=21999
OPENSWARM_RUNTIME_HEALTH_INTERVAL_MS=30000
OPENSWARM_RUNTIME_MAX_AUTO_RESTART=3

# Main gateway endpoint
GATEWAY_MAIN=ws://127.0.0.1:18789

# Optional quota/runtime tuning
# OPENSWARM_RUNTIME_RECYCLE_IDLE_MINUTES=30
