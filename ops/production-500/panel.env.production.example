# OpenSwarm panel-web production env (target: ~500 online users)
# Copy to /etc/openswarm/panel.env and replace placeholders.

NODE_ENV=production
PANEL_WEB_PORT=3999
OPENSWARM_PUBLIC_BASE_URL=https://your-domain.example.com

# If panel and DB are on the same host, keep localhost.
DATABASE_URL=postgres://openswarm:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/openswarm
DATABASE_SSLMODE=require

# pg pool defaults to 10 in code; increase for higher concurrent API traffic.
DATABASE_POOL_MAX=30
DATABASE_IDLE_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=3000

# Auth
OPENSWARM_REQUIRE_USER_AUTH=1
OPENSWARM_AUTH_JWT_SECRET=CHANGE_ME_PHASE1_JWT_SECRET
OPENSWARM_AUTH_REFRESH_SECRET=CHANGE_ME_PHASE1_REFRESH_SECRET
OPENSWARM_AUTH_COOKIE_SECURE=1
OPENSWARM_V1_JWT_SECRET=CHANGE_ME_V1_JWT_SECRET

# Optional legacy panel token gate
# OPENSWARM_PANEL_TOKEN=CHANGE_ME_PANEL_TOKEN
# OPENSWARM_V1_REQUIRE_PANEL_TOKEN=0

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example.com/api/auth/google/callback

# Runtime mode: local or k8s
OPENSWARM_RUNTIME_MODE=local
OPENSWARM_RUNTIME_TOKEN_SECRET=CHANGE_ME_RUNTIME_SECRET
OPENSWARM_TENANT_RUNTIME_BASE_DIR=/data/openswarm/runtime/tenants
OPENSWARM_TENANT_RUNTIME_LOG_DIR=/data/openswarm/runtime/logs

# Main gateway endpoint
GATEWAY_MAIN=ws://127.0.0.1:18789
# Optional if gateway requires token
# OPENSWARM_GATEWAY_TOKEN=CHANGE_ME_GATEWAY_TOKEN
