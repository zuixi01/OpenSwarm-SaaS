# OpenSwarm Panel SaaS env example
# 将需要的配置写入项目根目录 .env；此示例文件不会被 Node 自动加载。

# ── Core Service ───────────────────────────────────────────────────────────────
# 可选：面板端口，默认 3999
# PANEL_WEB_PORT=3999
# 默认仅监听本机；容器内设为 0.0.0.0。远程访问前先配置鉴权和反向代理。
# PANEL_WEB_HOST=127.0.0.1

# 生产环境建议设置公开域名
# OPENSWARM_PUBLIC_BASE_URL=https://your-domain.example.com

# ── Database ──────────────────────────────────────────────────────────────────
# SaaS/多租户模式必填
# DATABASE_URL=postgres://user:pass@host:5432/openswarm
# DATABASE_SSLMODE=require
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_MS=30000
# DATABASE_CONNECT_TIMEOUT_MS=5000

# ── Auth / Session ────────────────────────────────────────────────────────────
# SaaS 模式必填
# OPENSWARM_REQUIRE_USER_AUTH=1
# OPENSWARM_AUTH_JWT_SECRET=replace-with-strong-random-secret
# OPENSWARM_AUTH_REFRESH_SECRET=replace-with-another-strong-secret
# OPENSWARM_AUTH_REFRESH_DAYS=7
# OPENSWARM_AUTH_WEB_ACCESS_HOURS=24
# OPENSWARM_AUTH_COOKIE_SECURE=1

# ── Google OAuth Login ────────────────────────────────────────────────────────
# 开启 Google 登录必填
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example.com/api/auth/google/callback

# ── Runtime / Tenant Runtime ──────────────────────────────────────────────────
# OPENSWARM_RUNTIME_TOKEN_SECRET=replace-with-runtime-token-secret
# OPENSWARM_TENANT_RUNTIME_BASE_DIR=/data/openswarm/runtime/tenants
# OPENSWARM_TENANT_RUNTIME_LOG_DIR=/data/openswarm/runtime/logs
# OPENSWARM_TENANT_RUNTIME_PORT_START=19001
# OPENSWARM_TENANT_RUNTIME_PORT_END=21999
# OPENSWARM_RUNTIME_HEALTH_INTERVAL_MS=30000
# OPENSWARM_RUNTIME_MAX_AUTO_RESTART=3

# ── Budget / Quota ────────────────────────────────────────────────────────────
# OPENSWARM_QUOTA_DEFAULT_PLAN=free
# OPENSWARM_RUNTIME_RECYCLE_IDLE_MINUTES=30

# ── Optional Provider Override ────────────────────────────────────────────────
# 与阴对话会从 阴/moltbot.json 自动读取 gateway token，通常无需手动配置。
# 若需覆盖，可设：
# OPENSWARM_GATEWAY_TOKEN=your-token
