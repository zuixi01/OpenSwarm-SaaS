                                  │\n│  ┌────────────────────────────────────────────────────────────────┐ │\n│  │  📱 屏幕参数                                                    │ │\n│  │  ─────────────────────────────────────────────────────────────  │ │\n│  │                                                                │ │\n│  │  ┌────────────┬──────────────┬──────────────┬──────────────┐  │ │\n│  │  │  屏幕尺寸  │   6.3英寸    │   6.1英寸    │   6.1英寸    │  │ │\n│  │  │  [差异]    │  🔵 更大     │              │              │  │ │\n│  │  ├────────────┼──────────────┼──────────────┼──────────────┤  │ │\n│  │  │  分辨率    │ 2622×1206   │ 2556×1179   │ 2556×1179   │  │ │\n│  │  │  [差异]    │  🔵 更高     │              │              │  │ │\n│  │  ├────────────┼──────────────┼──────────────┼──────────────┤  │ │\n│  │  │  刷新率    │   120Hz      │   120Hz      │   120Hz      │  │ │\n│  │  │  [相同]    │              │              │              │  │ │\n│  │  ├────────────┼──────────────┼──────────────┼──────────────┤  │ │\n│  │  │  屏幕材质  │ Super Retina │ Super Retina │ Super Retina │  │ │\n│  │  │            │    XDR      │    XDR      │    XDR      │  │ │\n│  │  │  [相同]    │              │              │              │  │ │\n│  │  └────────────┴──────────────┴──────────────┴──────────────┘  │ │\n│  │                                                                │ │\n│  └────────────────────────────────────────────────────────────────┘ │\n│                                                                      │\n│  ┌────────────────────────────────────────────────────────────────┐ │\n│  │  ⚡ 性能配置                                                    │ │\n│  │  ─────────────────────────────────────────────────────────────  │ │\n│  │                                                                │ │\n│  │  ┌────────────┬──────────────┬──────────────┬──────────────┐  │ │\n│  │  │   芯片     │   A18 Pro    │   A17 Pro    │   A16        │  │ │\n│  │  │  [差异]    │  🔵 最强     │              │          